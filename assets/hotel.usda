        def Scope "L3"
        {
            def "Materials"
            {
                def Material "Parquet"
                {
                    token outputs:surface.connect = </World/Hotel/L3/Materials/Parquet/Surface.outputs:surface>

                    def Shader "Surface"
                    {
                        uniform token info:id = "UsdPreviewSurface"
                        color3f inputs:diffuseColor.connect = </World/Hotel/L3/Materials/Parquet/Color.outputs:rgb>
                        float inputs:metallic.connect = </World/Hotel/L3/Materials/Parquet/ORM.outputs:b>
                        normal3f inputs:normal.connect = </World/Hotel/L3/Materials/Parquet/Normal.outputs:rgb>
                        float inputs:occlusion.connect = </World/Hotel/L3/Materials/Parquet/ORM.outputs:r>
                        float inputs:roughness.connect = </World/Hotel/L3/Materials/Parquet/ORM.outputs:g>
                        token outputs:surface
                    }

                    def Shader "UV"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        string inputs:varname = "st"
                        float2 outputs:result
                    }

                    def Shader "Color"
                    {
                        uniform token info:id = "UsdUVTexture"
                        asset inputs:file = @./furniture/parquet/herringbone_parquet_diff_1k.jpg@
                        token inputs:sourceColorSpace = "sRGB"
                        float2 inputs:st.connect = </World/Hotel/L3/Materials/Parquet/UV.outputs:result>
                        token inputs:wrapS = "repeat"
                        token inputs:wrapT = "repeat"
                        float3 outputs:rgb
                    }

                    def Shader "Normal"
                    {
                        uniform token info:id = "UsdUVTexture"
                        float4 inputs:bias = (-1, -1, -1, 0)
                        asset inputs:file = @./furniture/parquet/herringbone_parquet_nor_gl_1k.jpg@
                        float4 inputs:scale = (2, 2, 2, 1)
                        token inputs:sourceColorSpace = "raw"
                        float2 inputs:st.connect = </World/Hotel/L3/Materials/Parquet/UV.outputs:result>
                        token inputs:wrapS = "repeat"
                        token inputs:wrapT = "repeat"
                        float3 outputs:rgb
                    }

                    def Shader "ORM"
                    {
                        uniform token info:id = "UsdUVTexture"
                        asset inputs:file = @./furniture/parquet/herringbone_parquet_arm_1k.jpg@
                        token inputs:sourceColorSpace = "raw"
                        float2 inputs:st.connect = </World/Hotel/L3/Materials/Parquet/UV.outputs:result>
                        token inputs:wrapS = "repeat"
                        token inputs:wrapT = "repeat"
                        float outputs:b
                        float outputs:g
                        float outputs:r
                    }
                }
            }

