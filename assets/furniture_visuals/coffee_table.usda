#usda 1.0
(
    defaultPrim = "Furniture"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Furniture"
{
    def Xform "Center"
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (-0, -0, -0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "Model" (
            prepend references = @../furniture/coffee_table/model.usdc@
        )
        {
            over "Links"
            {
                over "steel_base" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "mount_plate"
                        {
                            over "Geom"
                            {
                                over "mount_plate_obj" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "leg_0"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "leg_1"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "leg_2"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }

                over "marble_top" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "marble_slab"
                        {
                            over "Geom"
                            {
                                over "marble_slab_obj" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }

            over "Joints"
            {
                over "top_to_base" (
                    active = false
                )
                {
                }
            }
        }
    }
}

