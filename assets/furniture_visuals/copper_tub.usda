#usda 1.0
(
    defaultPrim = "Furniture"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Furniture"
{
    def Xform "Center"
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (-0, -0, -0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "Model" (
            prepend references = @../furniture/copper_tub/model.usdc@
        )
        {
            over "Links"
            {
                over "tub" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "shell"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "nickel_interior"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "rim_roll"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "drain_flange"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }

                over "drain_plug" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "plug_body"
                        {
                            over "Geom"
                            {
                                over "mesh_component_000" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }

                                over "mesh_component_001" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }

                                over "mesh_component_002" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }

            over "Joints"
            {
                over "drain_seat" (
                    active = false
                )
                {
                }
            }
        }
    }
}

