#usda 1.0
(
    defaultPrim = "Furniture"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Furniture"
{
    def Xform "Center"
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (1.4901160860780749e-9, -0, 2.98023217215615e-10)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "Model" (
            prepend references = @../furniture/checkout/model.usdc@
        )
        {
            over "Links"
            {
                over "base" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "plinth_skirt_front"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "plinth_skirt_back"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

