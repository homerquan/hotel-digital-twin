                            )
                            {
                            }
                        }

                        over "plinth_rim_right"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }
                    }
                }

                over "carcass" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "front_panel"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "end_panel_left"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "end_panel_right"
