#usda 1.0
(
    defaultPrim = "Furniture"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Furniture"
{
    def Xform "Center"
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (-0, 0.007500002098539113, 2.980232241545089e-9)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "Model" (
            prepend references = @../furniture/nightstand/model.usdc@
        )
        {
            over "Links"
            {
                over "frame" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "left_side"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "right_side"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "back_panel"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "bottom_panel"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "top_front_rail"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "drawer_shelf"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "divider_shelf"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "leg_front_left"
                        {
                            over "GeomHull" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "leg_front_right"
                        {
                            over "GeomHull" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "leg_rear_left"
                        {
                            over "GeomHull" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "leg_rear_right"
                        {
                            over "GeomHull" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }
                    }
                }

                over "top" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "top_slab"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }
                    }
                }

                over "drawer" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "drawer_front"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "drawer_bottom"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "drawer_left_side"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "drawer_right_side"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "drawer_back"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "ring_pull"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "ring_pin"
                        {
                            over "GeomHull" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "ring_rosette"
                        {
                            over "GeomHull" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "Joints"
            {
                over "top_on_frame" (
                    active = false
                )
                {
                }

                over "drawer_slide" (
                    active = false
                )
                {
                }
            }
        }
    }
}

