#usda 1.0
(
    defaultPrim = "Furniture"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Furniture"
{
    def Xform "Center"
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (-0, -0, 1.490116086078075e-10)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "Model" (
            prepend references = @../furniture/bookshelf/model.usdc@
        )
        {
            over "Links"
            {
                over "bookcase" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "left_side"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "right_side"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "top_board"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "shelf_1"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "shelf_2"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "shelf_3"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "shelf_4"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "shelf_5"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "back_panel"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "plinth"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }
        }
    }
}

