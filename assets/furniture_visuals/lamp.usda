#usda 1.0
(
    defaultPrim = "Furniture"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Furniture"
{
    def Xform "Center"
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (-0, -0, -0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "Model" (
            prepend references = @../furniture/lamp/model.usdc@
        )
        {
            over "Links"
            {
                over "base" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "gourd_body"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "foot_plinth"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "neck_collar"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "switch_bezel"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }

                over "switch" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "button"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }

                over "socket" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "socket_cup"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "harp"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "fitter_stud"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "finial"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "bulb_base"
                        {
                            over "GeomHull" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }

                        over "bulb_globe"
                        {
                            over "Geom" (
                                delete apiSchemas = ["PhysicsCollisionAPI"]
                            )
                            {
                            }
                        }
                    }
                }

                over "shade" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "Collisions"
                    {
                        over "shade_shell"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }

                        over "shade_plate"
                        {
                            over "Geom"
                            {
                                over "mesh" (
                                    delete apiSchemas = ["PhysicsCollisionAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }

            over "Joints"
            {
                over "switch_travel" (
                    active = false
                )
                {
                }

                over "base_to_socket" (
                    active = false
                )
                {
                }

                over "socket_to_shade" (
                    active = false
                )
                {
                }
            }
        }
    }
}

